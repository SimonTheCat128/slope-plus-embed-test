t invalid (inf or nan) rotation!\00Submitted! We will check out your game and publish it shortly. Tap the Publish button at any time to check the status of your submission!\00Set Velocity got invalid (inf or nan) spin!\00Cancelled because the data requires a newer version of Fancade. Update the app and try again!\00Go again!\00Cool item!\00Free gem!\00Incorrect email!\00No room to add another level!\00Last level is not the \22Assets\22 level!\00Gooooal!\00Collect %i more stars and complete %i%% of World %i!\00Complete %i%% of World %i!\00Earn %i more crowns to unlock Arena %i!\00Doh!\00Time is Ticking!\00Environment list too big!\00List too big!\00Add Force got invalid (inf or nan) torque!\00Complete!\00Quest reset! Please tap again to restart the app before doing anything else!\00Beat your score!\00Set a new high score!\00Beat gold score!\00To create a challenge, play any published highscore game in the 'Arcade' tab and then navigate to the 'Challenge Friends' page after setting a score!\00Get more gems here!\00Another copy of this block has no free space here!\00Done!\00Gold time!\00To Battle!\00You have completed %s of %s in Battle!\00You have completed %s of Battle!\00You'll need %i more gems! Earn some in the daily challenge!\00Daily Challenge!\00New Challenge!\00Simple Game Challenge!\00Save is disabled in this mode!\00Play VS mode!\00Add Force got invalid (inf or nan) force!\00Last Chance!\00Not enough space!\00Double Reward!\00An asset was not found!\00approved!\00Your submission is still in review.\0a\0aYou can help speed up this process by evaluating other people's games. Enable the Moderation option on the 'You' tab to get started!\00Tick the box to get a notification when bridge repairs are completed!\00Pure virtual function called!\00Worked!\00World Unlocked!\00VS Unlocked!\00Copied!\00Medic!\00Find new content to review in the 'Arcade' tab!\00Failed to load progress data!\00You have reached the final Arena!\00Final race!!!\00Earn %i\1f!\00You found a chest with %i\1a!\00by \00%s \00Ninja Tower \00%i \00Free \00 and \00> \00Time: \00, \00Follows  \00World %i:  \00%i/%i\1f\00Be fast to earn %i\1f\00Score points to earn %i\1f\00Play levels to earn %i\1f\00Complete levels to earn %i\1f\00Beat scores to earn %i\1f\00Survive to earn %i\1f\00\1c\00\1b  %s  \1b\00\18 Challenge \19\00\18 3 \19\00\18 2 \19\00\18 1 \19\00\03\03\0b\00uniform mat4 m_mat;\0auniform mat4 mvp_mat;\0auniform mat4 depth_mat;\0auniform mat4 sp_mat;\0auniform vec3 light;\0auniform vec2 fog_dist;\0auniform vec3 fog_center;\0auniform float zoom;\0aIN vec3 pos;\0aIN vec3 normal;\0aIN vec3 uvl;\0aOUT vec3 myuvl;\0aOUT vec3 shadow_pos;\0aOUT float form_shadow;\0aOUT float fog;\0aOUT float spread;\0a\0avoid main() {\0a  gl_Position = sp_mat * mvp_mat * vec4(pos, 1.0);\0a  vec3 n = (m_mat * vec4(normal, 0.0)).xyz;\0a\0a  // UVs\0a  myuvl = uvl;\0a\0a  // Dot product of light and model-space normal ([0...1] how much form shadow to apply to tri)\0a  // Multiple dot product by 1.4 so tris aren't shadowed until at > 45 degree angle to light.\0a  // - Light straight on:  form_shadow = clamp(1.4 * -1.0 + 1, 0, 1) = 0\0a  // - Light 45 degrees:   form_shadow = clamp(1.4 * -0.7 + 1, 0, 1) = 0\0a  // - Light 67.5 degrees: form_shadow = clamp(1.4 * -0.4 + 1, 0, 1) = 0.6\0a  // - Light parallel:     form_shadow = clamp(1.4 *  0.0 + 1, 0, 1) = 1\0a  // - Light from back:    form_shadow = clamp(1.4 *  1.0 + 1, 0, 1) = 1\0a  float dot_n_light = dot(n, light);\0a  form_shadow = clamp(1.4 * dot_n_light + 1.0, 0.0, 1.0);\0a\0a  // Distance from fog_center ([0..1] how much to fade out cast_shadow before reaching depth_map edge)\0a  // - 0  from fog_center: fog = clamp(( 0 - 8) / 8, 0, 1) = clamp(-1, 0, 1) = 0\0a  // - 8  from fog_center: fog = clamp(( 8 - 8) / 8, 0, 1) = clamp( 0, 0, 1) = 0\0a  // - 12 from fog_center: fog = clamp((12 - 8) / 8, 0, 1) = clamp(.5, 0, 1) = 0.5\0a  // - 16 from fog_center: fog = clamp((16 - 8) / 8, 0, 1) = clamp( 1, 0, 1) = 1\0a  // - 24 from fog_center: fog = clamp((24 - 8) / 8, 0, 1) = clamp( 2, 0, 1) = 1\0a  vec4 m_pos = m_mat * vec4(pos, 1.0);\0a  float dx = m_pos.x - fog_center.x;\0a  float dz = m_pos.z - fog_center.z;\0a  float dist = sqrt(dx * dx + dz * dz);\0a  fog = clamp((dist - fog_dist.x) / (fog_dist.y - fog_dist.x), 0.0, 1.0);\0a\0a  // Normal offset shadow map bias\0a  // https://www.gamedev.net/forums/topic/665740-can39t-fix-shadow-acne-with-bias/\0a  // https://www.gamedev.net/blogs/entry/2260845-me-and-my-shadow/\0a  // http://www.dissidentlogic.com/old/images/NormalOffsetShadows/GDC_Poster_NormalOffset.png\0a  //\0a  // This removes self-shadowing and peter-panning, but bleeds shadows on inner\0a  // edges, e.g. where a block stands on a floor. However, this almost looks\0a  // good, like a form of AO highlighting edges. At the very least it looks\0a  // better than peter-panning!\0a  spread = min(0.01 / zoom, 0.001);\0a  // float noffs = max(0.0055 * zoom, 0.1); // With < 0.0055 I get self-shadowing on iPad\0a  // float noffs = max(0.009 * zoom, 0.1); // With <= 0.00875 I get self-shadowing on my Note5 (and various users also reported it) \0a  // float noffs = max(0.05 * zoom, 0.1); // Changed in 1.8 for reducing shadow acne in perspective mode \0a  float noffs = max(0.009 * zoom, 0.1); // Changed again in 1.8 because quest box shadows vanished \0a  vec3 pos2 = pos + noffs * normal;\0a  shadow_pos = (depth_mat * vec4(pos2, 1.0)).xyz;\0a}\0a\00uniform mat4 mvp_mat;\0aIN vec3 pos;\0aIN vec2 uv;\0aOUT vec2 myuv;\0a\0avoid main() {\0a  gl_Position = mvp_mat * vec4(pos, 1.0);\0a  myuv = uv;\0a}\0a\00FLOAT_PRECISION_HIGH;\0a\0auniform mat4 mvp_mat;\0aIN vec3 pos;\0aOUT vec4 mypos;\0a\0avoid main() {\0a  mypos = mvp_mat * vec4(pos, 1.0);\0a  gl_Position = mypos;\0a}\0a\00FLOAT_PRECISION_HIGH;\0a\0aIN vec4 mypos;\0a\0avoid main() {\0a  float depth = mypos.z;\0a  depth = 0.5 * depth + 0.5; // scale -1.0;1.0 to 0.0;1.0 \0a  // pack value into 32-bit RGBA texture\0a  // NOTE: I changed 256 to 255, which seems to have fixed an issue with a spurious bias that depends on camera dist!?\0a  const vec4 bit_shift = vec4(255.0 * 255.0 * 255.0, 255.0 * 255.0, 255.0, 1.0);\0a  const vec4 bit_mask  = vec4(0, 1.0 / 255.0, 1.0 / 255.0, 1.0 / 255.0);\0a  vec4 pack = fract(depth * bit_shift);\0a  pack -= pack.xxyz * bit_mask;\0a  FRAGCOLOR = pack;\0a}\0a\00FLOAT_PRECISION_HIGH;\0a\0auniform sampler2D tex;\0aIN vec2 myuv;\0a\0avoid main() {\0a  // SHADER_FRAGCOLOR .rgba = vec4(1.0, 1.0, 1.0, 1.0);\0a  float a =  TEXTURE(tex, myuv).a;\0a  if (a < 0.5) discard;\0a}\0a\00FLOAT_PRECISION_MEDIUM;\0a\0auniform sampler2D tex;\0aIN vec2 myuv;\0aIN vec4 myrgba;\0a\0avoid main() {\0a  FRAGCOLOR.rgba = TEXTURE(tex, myuv) * myrgba;\0a  if (FRAGCOLOR.a == 0.0) discard;\0a}\0a\00FLOAT_PRECISION_MEDIUM;\0a\0auniform sampler2D tex;\0aIN vec2 myuv;\0aIN vec4 myrgba;\0a\0avoid main() {\0a  FRAGCOLOR.rgba = TEXTURE(tex, myuv, 7.0) * myrgba;\0a}\0a\00uniform mat4 mvp_mat;\0aIN vec3 pos;\0aIN vec2 uv;\0aIN vec4 rgba;\0aOUT vec2 myuv;\0aOUT vec4 myrgba;\0a\0avoid main() {\0a  gl_Position = mvp_mat * vec4(pos, 1.0);\0a  myuv = uv;\0a  myrgba = rgba;\0a}\0a\00uniform mat4 mvp_mat;\0auniform mat4 sp_mat;\0aIN vec3 pos;\0aIN vec2 uv;\0aIN vec4 rgba;\0aOUT vec2 myuv;\0aOUT vec4 myrgba;\0a\0avoid main() {\0a  gl_Position = sp_mat * mvp_mat * vec4(pos, 1.0);\0a  myuv = uv;\0a  myrgba = rgba;\0a}\0a\00FLOAT_PRECISION_HIGH;\0a\0auniform sampler2D depth_map;\0auniform sampler2D tex;\0auniform vec3 tint;\0a// uniform sampler2D poisson_texture;\0aIN vec3 myuvl;\0aIN vec3 shadow_pos;\0aIN float form_shadow;\0aIN float fog;\0aIN float spread;\0a\0afloat PHI = 1.61803398874989484820459;\0a// Returns a random number based on a vec2 and an int\0afloat random(vec2 xy, float seed) {\0a  return fract(tan(distance(xy * PHI, xy) * seed) * xy.x);\0a}\0a\0avec2 rotate(vec2 v, float a) { \0a\09float s = sin(a); \0a\09float c = cos(a); \0a\09mat2 m = mat2(c, -s, s, c); \0a\09return m * v; \0a} \0a\0amat2 rot_mat2(float a) { \0a\09float s = sin(a); \0a\09float c = cos(a); \0a\09mat2 m = mat2(c, -s, s, c); \0a\09return m; \0a} \0a\0avoid main() {\0a  // Shadow according to depth_map ([0...1] how much cast shadow) \0a  const vec4 bit_shift = vec4(1.0 / (255.0 * 255.0 * 255.0), 1.0 / (255.0 * 255.0), 1.0 / 255.0, 1.0);\0a  float cast_shadow = 0.0;\0a  // const float spread = 1.0 / 700.0;\0a  \0a  // Old sampling method\0a  vec4 pack1 = TEXTURE(depth_map, shadow_pos.xy + vec2( -0.94201624,  -0.39906216 ) * spread);\0a  vec4 pack2 = TEXTURE(depth_map, shadow_pos.xy + vec2(  0.94558609,  -0.76890725 ) * spread);\0a  vec4 pack3 = TEXTURE(depth_map, shadow_pos.xy + vec2( -0.094184101, -0.92938870 ) * spread);\0a  vec4 pack4 = TEXTURE(depth_map, shadow_pos.xy + vec2(  0.34495938,   0.29387760 ) * spread);\0a\0a  // Rotated Poisson, one matrix\0a  // float rnd = random(gl_FragCoord.xy, 1.0);\0a  // mat2 ma = rot_mat2(6.28423 * rnd);\0a  // vec4 pack1 =  SHADER_TEXTURE (depth_map, shadow_pos.xy + (ma * vec2( -0.94201624,  -0.39906216 )) * spread);\0a  // vec4 pack2 =  SHADER_TEXTURE (depth_map, shadow_pos.xy + (ma * vec2(  0.94558609,  -0.76890725 )) * spread);\0a  // vec4 pack3 =  SHADER_TEXTURE (depth_map, shadow_pos.xy + (ma * vec2( -0.094184101, -0.92938870 )) * spread);\0a  // vec4 pack4 =  SHADER_TEXTURE (depth_map, shadow_pos.xy + (ma * vec2(  0.34495938,   0.29387760 )) * spread);\0a\0a  // Rotated Poisson, four matrices\0a  // mat2 ma1 = rot_mat2(6.28423 * random(gl_FragCoord.xy, 1.0));\0a  // mat2 ma2 = rot_mat2(6.28423 * random(gl_FragCoord.xy, 2.0));\0a  // mat2 ma3 = rot_mat2(6.28423 * random(gl_FragCoord.xy, 3.0));\0a  // mat2 ma4 = rot_mat2(6.28423 * random(gl_FragCoord.xy, 4.0));\0a  // vec4 pack1 =  SHADER_TEXTURE (depth_map, shadow_pos.xy + ma1 * vec2( -0.94201624,  -0.39906216 ) * spread);\0a  // vec4 pack2 =  SHADER_TEXTURE (depth_map, shadow_pos.xy + ma2 * vec2(  0.94558609,  -0.76890725 ) * spread);\0a  // vec4 pack3 =  SHADER_TEXTURE (depth_map, shadow_pos.xy + ma3 * vec2( -0.094184101, -0.92938870 ) * spread);\0a  // vec4 pack4 =  SHADER_TEXTURE (depth_map, shadow_pos.xy + ma4 * vec2(  0.34495938,   0.29387760 ) * spread);\0a\0a  // Stratified Poisson\0a  // vec2 index1 = vec2(random(gl_FragCoord.xy, 1.0), 0.0);\0a  // vec2 index2 = vec2(random(gl_FragCoord.xy, 2.0), 0.0);\0a  // vec2 index3 = vec2(random(gl_FragCoord.xy, 3.0), 0.0);\0a  // vec2 index4 = vec2(random(gl_FragCoord.xy, 4.0), 0.0);\0a  // vec2 offset1 = 2.0 *  SHADER_TEXTURE (poisson_texture, index1).xy - vec2(1.0, 1.0);\0a  // vec2 offset2 = 2.0 *  SHADER_TEXTURE (poisson_texture, index2).xy - vec2(1.0, 1.0);\0a  // vec2 offset3 = 2.0 *  SHADER_TEXTURE (poisson_texture, index3).xy - vec2(1.0, 1.0);\0a  // vec2 offset4 = 2.0 *  SHADER_TEXTURE (poisson_texture, index4).xy - vec2(1.0, 1.0);\0a  // vec4 pack1 =  SHADER_TEXTURE (depth_map, shadow_pos.xy + offset1 * spread);\0a  // vec4 pack2 =  SHADER_TEXTURE (depth_map, shadow_pos.xy + offset2 * spread);\0a  // vec4 pack3 =  SHADER_TEXTURE (depth_map, shadow_pos.xy + offset3 * spread);\0a  // vec4 pack4 =  SHADER_TEXTURE (depth_map, shadow_pos.xy + offset4 * spread);\0a\0a  float dist_from_light1 = dot(pack1, bit_shift); // Unpack\0a  float dist_from_light2 = dot(pack2, bit_shift); // Unpack\0a  float dist_from_light3 = dot(pack3, bit_shift); // Unpack\0a  float dist_from_light4 = dot(pack4, bit_shift); // Unpack\0a  cast_shadow += 0.25 * float(dist_from_light1 < shadow_pos.z);\0a  cast_shadow += 0.25 * float(dist_from_light2 < shadow_pos.z);\0a  cast_shadow += 0.25 * float(dist_from_light3 < shadow_pos.z);\0a  cast_shadow += 0.25 * float(dist_from_light4 < shadow_pos.z);\0a\0a  // Fade out cast_shadow before reaching depth_map's edge\0a  cast_shadow *= (1.0 - fog);\0a\0a  // Combine form_shadow and cast_shadow ([0...1] how much to actually darken tri)\0a  // - form_shadow =  1 && cast_shadow = 1: shadow = 1\0a  // - form_shadow = .5 && cast_shadow = 1: shadow = 1\0a  // - form_shadow =  0 && cast_shadow = 1: shadow = 1\0a  // - form_shadow =  1 && cast_shadow = 0: shadow = 1\0a  // - form_shadow = .5 && cast_shadow = 0: shadow = 0.5\0a  // - form_shadow =  0 && cast_shadow = 0: shadow = 0\0a  float shadow = min(1.0, form_shadow + cast_shadow);\0a\0a  // Apply (color-tinted) shadow\0a  vec3 rgb1 = TEXTURE(tex, myuvl.xy).rgb;\0a  vec3 rgb2 = TEXTURE(tex, vec2(myuvl.x + (10.0 / 2048.0), myuvl.y)).rgb;\0a  vec3 rgb = myuvl.z * rgb1 + (1.0 - myuvl.z) * rgb2;\0a  float light = myuvl.z - 0.35 * shadow;\0a  FRAGCOLOR.rgb = tint * (light * rgb1 + (1.0 - light) * rgb2);\0a  FRAGCOLOR.a = 1.0;\0a}\0a\00#version 100\0a#define IN attribute\0a#define OUT varying\0a#define FLOAT_PRECISION_MEDIUM precision mediump float\0a#define FLOAT_PRECISION_HIGH precision highp float\0a\00#version 100\0a#define IN varying\0a#define FRAGCOLOR gl_FragColor\0a#define TEXTURE texture2D\0a#define FLOAT_PRECISION_MEDIUM precision mediump float\0a#define FLOAT_PRECISION_HIGH precision highp float\0a\00Challenged by %s in %s%s\0a\00%s has to beat %s in %s%s\0a\00You challenged %s to beat %s in %s%s\0a\00Won over %s in %s%s\0a\00Lost to %s in %s%s\0a\00Challenged %s in %s%s\0a\00Followed %s\0a\00Error before: %s\0a\00If you can reproduce this, please email bugs@continuousphysics.com\0a\00\22%s\22, %i\0a\00Error: json file was not parsed correctly.\0a\00Thanks.\0a\00No new sales.\0a\00Please include above information, your Platform, version of OS.\0a\00Published a new game '%s'\0a\00Updated the game '%s'\0a\00%s got %s in %s%s!\0a\00%s challenged you to beat %s in %s%s!\0a\00Other games: %s\1f\0a\00%s: %s\1f\0a\00\09\00\02\03\07\00\05\05\04\00\01\80\01\80\01\80\00\00\00\00\00\00\01\00\00\00\02\00\00\00\00\00\00\00\02\00\00\00\03\00\00\00\05\00\00\00\04\00\00\00\07\00\00\00\05\00\00\00\07\00\00\00\06\00\00\00\00\00\00\00\04\00\00\00\05\00\00\00\00\00\00\00\05\00\00\00\01\00\00\00\07\00\00\00\03\00\00\00\02\00\00\00\07\00\00\00\02\00\00\00\06\00\00\00\04\00\00\00\00\00\00\00\03\00\00\00\04\00\00\00\03\00\00\00\07\00\00\